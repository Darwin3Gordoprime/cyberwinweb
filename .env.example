PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_win
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DATABASE_SSL=false
FIREBASE_PROJECT_ID=replace-with-firebase-project-id

# Optional until creators enable Mux-powered RTMP/OBS streaming.
# Keep the Mux token secret stable: it also encrypts stored creator stream keys.
MUX_TOKEN_ID=replace-with-mux-token-id
MUX_TOKEN_SECRET=replace-with-mux-token-secret
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-signing-secret

# Configure Firebase Admin Application Default Credentials separately.
# Never store a service-account key in this file or commit it to the repository.
